#!/bin/sh
# git credential helper for github.com: answers with the token of the account mapped to the
# repo owner (~/.agents/gh-accounts); otherwise defers to gh's active account.
# Needs credential.https://github.com.useHttpPath=true so git sends the repo path.
[ "${1:-}" = get ] || exit 0
PATH="$PATH:/opt/homebrew/bin"
input=$(cat)
path=$(printf '%s\n' "$input" | sed -n 's/^path=//p')
acct=$("$(dirname "$0")/gh-account-for" "${path%%/*}")
if [ -n "$acct" ] && tok=$(gh auth token --user "$acct" 2>/dev/null); then
  printf 'username=%s\npassword=%s\n' "$acct" "$tok"
  exit 0
fi
printf '%s\n' "$input" | gh auth git-credential get
